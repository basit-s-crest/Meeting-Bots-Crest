# Zoom Web Client Meeting URL (standard /j/ format or /wc/join/)
MEETING_URL=https://zoom.us/j/1234567890

# Meeting Passcode (if required to join)
MEETING_PASSCODE=123456

# Bot Display Name
BOT_NAME=Zoom Note Taker

# Headless mode: true or false (false opens the browser window)
HEADLESS=true

# Output type: file (writes JSONs and manifest to disk) or websocket
OUTPUT_TYPE=file

# WebSocket port (if using websocket output type)
OUTPUT_PORT=8080
